	costPill.Position               = UDim2.new(0.05, 0, 0.79, 0)
	costPill.BackgroundColor3       = Color3.fromRGB(0, 0, 0)
	costPill.BackgroundTransparency = 0.42
	costPill.BorderSizePixel        = 0
	costPill.ZIndex                 = 6
	Instance.new("UICorner", costPill).CornerRadius = UDim.new(0, 6)
	local costLbl = Instance.new("TextLabel", costPill)
	costLbl.Name                   = "CostLabel"
	costLbl.Size                   = UDim2.new(1, 0, 1, 0)
	costLbl.BackgroundTransparency = 1
	costLbl.Text                   = skill.Cost == 0 and "FREE"
		or ("🪙 " .. formatCoins(skill.Cost))
