	checkBadge.Name             = "CheckBadge"
	checkBadge.Size             = UDim2.new(0, 24, 0, 24)
	checkBadge.Position         = UDim2.new(1, -26, 0, 2)
	checkBadge.BackgroundColor3 = Color3.fromRGB(50, 205, 90)
