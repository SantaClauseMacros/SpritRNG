-- SkillTreeClient.client.lua  (UPDATED)
-- Changes:
--   • MainFrame + NodesFrame are now full-screen (cover the whole viewport)
--   • A virtual Canvas lives inside NodesFrame — nodes are built on it
--   • LMB drag  → pans  the canvas
--   • Scroll wheel → zooms toward the mouse cursor
--   • Tree is automatically centred on screen when opened
--   • Deterministic per-skill position jitter gives an organic branching feel
--   • Pan and zoom wired once at init (no connection leaks on re-open)
--   • Drag-vs-click correctly distinguished (threshold = 6 px)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService      = game:GetService("TweenService")
local Players           = game:GetService("Players")
local UserInputService  = game:GetService("UserInputService")

local SkillTree = require(ReplicatedStorage:WaitForChild("SkillTree"))

-- ── Remotes ──────────────────────────────────────────────────────────────────
local GetSkillsEvent     = ReplicatedStorage:WaitForChild("GetSkillsEvent")
local BuySkillEvent      = ReplicatedStorage:WaitForChild("BuySkillEvent")
local SkillUnlockedEvent = ReplicatedStorage:WaitForChild("SkillUnlockedEvent")
local CoinsUpdateEvent   = ReplicatedStorage:WaitForChild("SkillCoinsUpdateEvent")

local ToggleSkillTree = ReplicatedStorage:FindFirstChild("ToggleSkillTree")
if not ToggleSkillTree then
	ToggleSkillTree        = Instance.new("BindableEvent")
	ToggleSkillTree.Name   = "ToggleSkillTree"
	ToggleSkillTree.Parent = ReplicatedStorage
end

-- ── GUI references ────────────────────────────────────────────────────────────
local player     = Players.LocalPlayer
local playerGui  = player:WaitForChild("PlayerGui")
local skillGui   = playerGui:WaitForChild("SkillTreeGui")
local mainFrame  = skillGui:WaitForChild("MainFrame")
local topBar     = mainFrame:WaitForChild("TopBar")
local closeBtn   = topBar:WaitForChild("CloseButton")
local coinsLbl   = topBar:WaitForChild("CoinsLabel")
local nodesFrame = mainFrame:WaitForChild("NodesFrame")

-- ── Layout constants ──────────────────────────────────────────────────────────
local NODE_W      = 110          -- node card width  (px)
local NODE_H      = 130          -- node card height (px)
local STEP_X      = NODE_W + 60  -- horizontal stride between columns
local STEP_Y      = NODE_H + 65  -- vertical   stride between rows
local CANVAS_HALF = 3500         -- half of virtual canvas (full = 7000 × 7000)
local MIN_ZOOM    = 0.3
local MAX_ZOOM    = 2.5

-- ── Runtime state ─────────────────────────────────────────────────────────────
local isOpen         = false
local currentCoins   = 0
local unlockedSkills = {}
local nodeFrames     = {}
local tooltip        = nil

local canvas      = nil          -- Frame (child of nodesFrame)
local uiScaleInst = nil          -- UIScale (child of canvas)

-- Pan / zoom
local canvasPos    = Vector2.new(0, 0)  -- canvas top-left in nodesFrame-local pixels
local canvasZoom   = 1.0
local isDragging   = false
local dragStart    = Vector2.new(0, 0)
local dragOrigin   = Vector2.new(0, 0)
local dragDistance = 0

-- ── Helpers ───────────────────────────────────────────────────────────────────

local function formatCoins(n)
	n = n or 0
	if     n >= 1000000 then return string.format("%.1fM", n / 1000000)
	elseif n >= 1000    then return string.format("%.1fK", n / 1000)
	end
	return tostring(math.floor(n))
end

-- Deterministic position jitter keyed on the skill Id string.
-- Same game session → same layout; still looks organic.
local function jitter(id, scale)
	local h = 0
	for i = 1, #id do
		h = (h * 31 + string.byte(id, i)) % 100000
	end
	local jx = ((h % 100)            - 50) * scale
	local jy = (math.floor(h / 100) % 100 - 50) * scale
	return jx, jy
end

-- Returns (canvasX, canvasY) — pixel offsets from the canvas top-left corner.
-- The logical tree centre sits at (CANVAS_HALF, CANVAS_HALF).
local function nodePos(skill)
	local wx = skill.Col * STEP_X
	local wy = skill.Row * STEP_Y
	-- Stagger odd columns slightly so vertical branches feel less grid-like
	if math.abs(skill.Col) % 2 == 1 then
		wy = wy + STEP_Y * 0.35
	end
	local jx, jy = jitter(skill.Id, 22)
	return CANVAS_HALF + wx + jx,
	CANVAS_HALF + wy + jy
end

-- ── Canvas creation ───────────────────────────────────────────────────────────

local function createCanvas()
	if canvas and canvas.Parent then canvas:Destroy() end

	canvas = Instance.new("Frame")
	canvas.Name                   = "SkillCanvas"
	canvas.Size                   = UDim2.new(0, CANVAS_HALF * 2, 0, CANVAS_HALF * 2)
	canvas.Position               = UDim2.new(0, 0, 0, 0)
	canvas.BackgroundTransparency = 1
	canvas.BorderSizePixel        = 0
	canvas.ClipsDescendants       = false
	canvas.ZIndex                 = 1
	canvas.Parent                 = nodesFrame

	uiScaleInst       = Instance.new("UIScale", canvas)
	uiScaleInst.Scale = canvasZoom
end

local function applyTransform()
	if not canvas or not uiScaleInst then return end
	uiScaleInst.Scale = canvasZoom
	canvas.Position   = UDim2.new(0, canvasPos.X, 0, canvasPos.Y)
end

-- Compute the average canvas-space position of all skill nodes.
local function treeCenter()
	local sumX, sumY, n = 0, 0, 0
	for _, skill in ipairs(SkillTree.Skills) do
		local px, py = nodePos(skill)
		sumX += px; sumY += py; n += 1
	end
	return (n > 0 and sumX / n or CANVAS_HALF),
	(n > 0 and sumY / n or CANVAS_HALF)
end

-- Shift the canvas so the tree's visual centre lands on the screen centre.
local function centreView()
	task.wait()   -- one frame so AbsoluteSize is valid
	local sf      = nodesFrame.AbsoluteSize
	local tcx, tcy = treeCenter()
	-- We need: canvasPos + treeCenter * zoom == screenCentre
	canvasPos = Vector2.new(
		sf.X / 2 - tcx * canvasZoom,
		sf.Y / 2 - tcy * canvasZoom
	)
	applyTransform()
end

-- ── Pan & Zoom ────────────────────────────────────────────────────────────────

-- Zoom toward an arbitrary point (nodesFrame-local coords).
local function doZoom(factor, localMouse)
	local newZoom = math.clamp(canvasZoom * factor, MIN_ZOOM, MAX_ZOOM)
	if newZoom == canvasZoom then return end
	local ratio = newZoom / canvasZoom
	-- Keep the canvas point under localMouse fixed on screen
	canvasPos  = localMouse - (localMouse - canvasPos) * ratio
	canvasZoom = newZoom
	applyTransform()
end

-- ── Input wiring (called once at startup) ─────────────────────────────────────
local inputWired = false

local function wireInput()
	if inputWired then return end
	inputWired = true

	-- LMB down → begin drag
	UserInputService.InputBegan:Connect(function(input, _)
		if not isOpen then return end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
		isDragging   = true
		dragDistance = 0
		dragStart    = Vector2.new(input.Position.X, input.Position.Y)
		dragOrigin   = canvasPos
	end)

	-- Mouse move → pan canvas; scroll wheel → zoom
	UserInputService.InputChanged:Connect(function(input)
		if not isOpen then return end

		if input.UserInputType == Enum.UserInputType.MouseMovement and isDragging then
			local pos    = Vector2.new(input.Position.X, input.Position.Y)
			local delta  = pos - dragStart
			dragDistance = delta.Magnitude
			if dragDistance > 4 then
				canvasPos = dragOrigin + delta
				applyTransform()
			end
		end

		if input.UserInputType == Enum.UserInputType.MouseWheel then
			local mouseScreen = UserInputService:GetMouseLocation()
			local nfAbs       = nodesFrame.AbsolutePosition
			local localMouse  = mouseScreen - nfAbs
			local factor      = input.Position.Z > 0 and 1.12 or (1 / 1.12)
			doZoom(factor, localMouse)
		end
	end)

	-- LMB up → end drag
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			isDragging = false
		end
	end)
end

-- ── Tooltip ───────────────────────────────────────────────────────────────────

local function buildTooltip()
	local t = Instance.new("Frame")
	t.Name                   = "SkillTooltip"
	t.Size                   = UDim2.new(0, 210, 0, 90)
	t.BackgroundColor3       = Color3.fromRGB(18, 18, 30)
	t.BackgroundTransparency = 0.05
	t.BorderSizePixel        = 0
	t.Visible                = false
	t.ZIndex                 = 50
	t.AnchorPoint            = Vector2.new(0.5, 1)
	t.Parent                 = mainFrame
	Instance.new("UICorner", t).CornerRadius = UDim.new(0, 10)
	local st = Instance.new("UIStroke", t)
	st.Color = Color3.fromRGB(160, 160, 255); st.Thickness = 1.5

	local function lbl(name, posY, h, sz, col, wrap)
		local l                    = Instance.new("TextLabel", t)
		l.Name                     = name
		l.Size                     = UDim2.new(1, -10, 0, h)
		l.Position                 = UDim2.new(0, 5, 0, posY)
		l.BackgroundTransparency   = 1
		l.TextColor3               = col
		l.Font                     = Enum.Font.FredokaOne
		l.TextSize                 = sz
		l.TextXAlignment           = Enum.TextXAlignment.Center
		l.TextWrapped              = wrap or false
		l.ZIndex                   = 51
		return l
	end

	lbl("TitleLabel", 5,  22, 15, Color3.fromRGB(255, 255, 255))
	lbl("DescLabel",  28, 38, 11, Color3.fromRGB(185, 185, 210), true)
	lbl("CostLabel",  70, 16, 12, Color3.fromRGB(255, 220, 80))
	return t
end

local function showTooltip(node, skill)
	if not tooltip then return end
	tooltip:FindFirstChild("TitleLabel").Text = skill.DisplayName
	tooltip:FindFirstChild("DescLabel").Text  = skill.Description
	tooltip:FindFirstChild("CostLabel").Text  =
		skill.Cost == 0 and "FREE"
		or ("Cost: " .. formatCoins(skill.Cost) .. " coins")

	local absPos  = node.AbsolutePosition
	local mainPos = mainFrame.AbsolutePosition
	local halfW   = 105
	local cx = math.clamp(
		absPos.X + node.AbsoluteSize.X / 2 - mainPos.X,
		halfW + 4,
		mainFrame.AbsoluteSize.X - halfW - 4
	)
	local cy = absPos.Y - mainPos.Y - 6
	tooltip.Position = UDim2.new(0, cx, 0, cy)
	tooltip.Visible  = true
end

local function hideTooltip()
	if tooltip then tooltip.Visible = false end
end

-- ── Connector lines ───────────────────────────────────────────────────────────

local function drawLine(ax, ay, bx, by, owned)
	local dx  = bx - ax
	local dy  = by - ay
	local len = math.sqrt(dx * dx + dy * dy)
	local ang = math.deg(math.atan2(dy, dx))

	local line = Instance.new("Frame")
	line.Size             = UDim2.new(0, len, 0, 5)
	line.Position         = UDim2.new(0, ax,  0, ay)
	line.AnchorPoint      = Vector2.new(0, 0.5)
	line.Rotation         = ang
	line.BackgroundColor3 = owned
		and Color3.fromRGB(65, 215, 100)
		or  Color3.fromRGB(58, 58, 82)
	line.BorderSizePixel  = 0
	line.ZIndex           = 2
	Instance.new("UICorner", line).CornerRadius = UDim.new(1, 0)
	line.Parent = canvas
	return line
end

-- ── Node construction ─────────────────────────────────────────────────────────

