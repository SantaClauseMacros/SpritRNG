-- ── Node visual state ─────────────────────────────────────────────────────────

local function updateNodeVisual(skill)
	local node = nodeFrames[skill.Id]
	if not node then return end

	local owned      = unlockedSkills[skill.Id]
	local prereqsMet = SkillTree.CanUnlock(skill.Id, unlockedSkills)
	local canAfford  = currentCoins >= skill.Cost
	local lockOv     = node:FindFirstChild("LockOverlay")
	local check      = node:FindFirstChild("CheckBadge")
	local stroke     = node:FindFirstChildOfClass("UIStroke")

	if owned then
		if lockOv  then lockOv.Visible  = false end
		if check   then check.Visible   = true  end
		if stroke  then
			stroke.Color        = Color3.fromRGB(50, 220, 90)
			stroke.Transparency = 0
		end
		node.BackgroundTransparency = 0

	elseif prereqsMet and canAfford then
		-- Available & affordable → gold border
		if lockOv  then lockOv.Visible = false end
		if check   then check.Visible  = false end
		if stroke  then
			stroke.Color        = Color3.fromRGB(255, 215, 50)
			stroke.Transparency = 0
		end
		node.BackgroundTransparency = 0

	elseif prereqsMet then
		-- Available but can't afford → red border
		if lockOv  then lockOv.Visible = false end
		if check   then check.Visible  = false end
		if stroke  then
			stroke.Color        = Color3.fromRGB(255, 60, 60)
			stroke.Transparency = 0.2
		end
		node.BackgroundTransparency = 0.15

	else
		-- Locked
		if lockOv  then lockOv.Visible = true  end
		if check   then check.Visible  = false end
		if stroke  then
			stroke.Color        = Color3.fromRGB(110, 110, 138)
			stroke.Transparency = 0.5
		end
		node.BackgroundTransparency = 0.45
	end
end

local function updateAllNodes()
	for _, skill in ipairs(SkillTree.Skills) do
		updateNodeVisual(skill)
	end
end

-- ── Click handler ─────────────────────────────────────────────────────────────

function onNodeClicked(skill)
	if dragDistance > 6 then return end   -- this was a pan drag, not a tap
	if unlockedSkills[skill.Id] then return end

	local node = nodeFrames[skill.Id]

	-- Missing prerequisites → shake node
	if not SkillTree.CanUnlock(skill.Id, unlockedSkills) then
		if node then
			task.spawn(function()
				for _, r in ipairs({ -8, 8, -6, 6, -3, 3, 0 }) do
					node.Rotation = r; task.wait(0.03)
				end
				node.Rotation = 0
			end)
		end
		return
	end

	-- Can't afford → flash red stroke
	if currentCoins < skill.Cost then
		if node then
			local stroke = node:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = Color3.fromRGB(255, 35, 35)
				task.delay(0.6, function()
					if stroke and stroke.Parent then updateNodeVisual(skill) end
				end)
			end
		end
		return
	end

	-- All good → pulse + fire server
	if node then
		TweenService:Create(node,
			TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Size = UDim2.new(0, NODE_W * 1.12, 0, NODE_H * 1.12) }):Play()
		task.delay(0.1, function()
			TweenService:Create(node,
				TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
				{ Size = UDim2.new(0, NODE_W, 0, NODE_H) }):Play()
		end)
	end

	BuySkillEvent:FireServer(skill.Id)
end

-- ── Build the full tree ───────────────────────────────────────────────────────

local function buildTree()
	-- Clear previous canvas contents (keep UIScale)
	for _, child in ipairs(canvas:GetChildren()) do
		if not child:IsA("UIScale") then child:Destroy() end
	end
	nodeFrames = {}

	local lookup = {}
	for _, skill in ipairs(SkillTree.Skills) do
		lookup[skill.Id] = skill
	end

	-- Draw connectors first so they sit behind nodes
	for _, skill in ipairs(SkillTree.Skills) do
		local tx, ty = nodePos(skill)
		for _, reqId in ipairs(skill.Requires) do
			local req = lookup[reqId]
			if req then
				local fx, fy = nodePos(req)
				drawLine(fx, fy, tx, ty, unlockedSkills[reqId])
			end
		end
	end

	-- Nodes on top
	for _, skill in ipairs(SkillTree.Skills) do
		buildNode(skill)
	end

	updateAllNodes()
end

-- ── Open / Close ──────────────────────────────────────────────────────────────

local function openTree()
	if isOpen then return end
	isOpen     = true
	canvasZoom = 1.0

	mainFrame.BackgroundTransparency = 1
	mainFrame.Visible = true

	TweenService:Create(mainFrame,
		TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ BackgroundTransparency = 0.08 }):Play()

	task.spawn(function()
		local data     = GetSkillsEvent:InvokeServer()
		unlockedSkills = data.unlocked or {}
		currentCoins   = data.coins    or 0
		coinsLbl.Text  = "🪙 " .. formatCoins(currentCoins)

		createCanvas()
		buildTree()
		centreView()
	end)
end

local function closeTree()
	if not isOpen then return end
	isOpen     = false
	isDragging = false
	hideTooltip()

	TweenService:Create(mainFrame,
		TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ BackgroundTransparency = 1 }):Play()

	task.delay(0.18, function()
		mainFrame.Visible = false
		if canvas then
			canvas:Destroy()
			canvas      = nil
			uiScaleInst = nil
		end
	end)
end

