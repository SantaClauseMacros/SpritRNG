	local cx, cy = nodePos(skill)

	local node = Instance.new("Frame")
	node.Name             = skill.Id
	node.Size             = UDim2.new(0, NODE_W, 0, NODE_H)
	node.Position         = UDim2.new(0, cx - NODE_W / 2, 0, cy - NODE_H / 2)
	node.BackgroundColor3 = skill.NodeColor
	node.BorderSizePixel  = 0
	node.ZIndex           = 5
	node.ClipsDescendants = false
	Instance.new("UICorner", node).CornerRadius = UDim.new(0, 16)

	-- Drop shadow (rendered below the node)
	local shadow = Instance.new("Frame", node)
	shadow.Size                   = UDim2.new(1, 10, 1, 10)
	shadow.Position               = UDim2.new(0, -5, 0, 6)
	shadow.BackgroundColor3       = Color3.fromRGB(0, 0, 0)
	shadow.BackgroundTransparency = 0.62
	shadow.BorderSizePixel        = 0
	shadow.ZIndex                 = 4
